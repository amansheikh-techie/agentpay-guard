# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables — copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_ENV=development
DATABASE_URL=sqlite:///./agentpay_guard.db
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_TOKEN=

# AI Provider (leave AI_API_KEY empty to use deterministic fallback mode)
# Supported AI_PROVIDER values: "openai", "gemini", "none"
# For Gemini (free tier), obtain an API key from Google AI Studio: https://aistudio.google.com/
# Suggested Gemini model: gemini-2.5-flash (or gemini-1.5-flash)
# Suggested OpenAI model: gpt-4o-mini
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=

# PayPal Sandbox — obtain credentials from https://developer.paypal.com/
# PAYPAL_CLIENT_SECRET must NEVER appear in frontend code or logs.
# Never commit real credentials to version control.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
